{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DDD API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/DDD/.venv/bin/python",
      "program": "${workspaceFolder}/DDD/main.py",
      "cwd": "${workspaceFolder}/DDD",
      "envFile": "${workspaceFolder}/DDD/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DDD auth-flow test",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/DDD/.venv/bin/python",
      "module": "unittest",
      "args": [
        "-v",
        "tests.test_http_server.HttpServerTests.test_register_and_login_are_public_use_cases"
      ],
      "cwd": "${workspaceFolder}/DDD",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DDD tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/DDD/.venv/bin/python",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "cwd": "${workspaceFolder}/DDD",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DDD request-flow test",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/DDD/.venv/bin/python",
      "module": "unittest",
      "args": [
        "-v",
        "tests.test_http_server.HttpServerTests.test_http_crud_and_owner_isolation"
      ],
      "cwd": "${workspaceFolder}/DDD",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
