# Firebase project's public Web API key, used by /auth/register and /auth/login.
FIREBASE_WEB_API_KEY=replace-with-your-firebase-web-api-key

# Optional overrides; uncomment only when needed. The local service account
# normally supplies the project ID.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_TASK_COLLECTION=tasks
# TODO_HOST=127.0.0.1
# TODO_PORT=8000
